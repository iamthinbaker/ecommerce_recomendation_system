<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_book_view_list" model="ir.ui.view">
        <field name="name">product.template.book.view.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Libros">
                <field name="name" string="Título"/>
                <field name="book_author" string="Autor"/>
                <field name="book_isbn" string="ISBN"/>
                <field name="book_genre_id" string="Género"/>
                <field name="list_price" string="Precio"/>
                <field name="website_published"/>
            </list>
        </field>
    </record>

    <record id="product_template_book_view_form" model="ir.ui.view">
        <field name="name">product.template.book.view.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Datos del Libro" name="book_data">
                    <group>
                        <group>
                            <field name="book_author"/>
                            <field name="book_isbn"/>
                            <field name="book_genre_id"/>
                        </group>
                        <group>
                            <field name="book_pages"/>
                            <field name="book_publisher"/>
                            <field name="book_year"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_book_action" model="ir.actions.act_window">
        <field name="name">Libros</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('categ_id', '=', ref('bookstore_recommendation.product_category_books'))]</field>
        <field name="context">{'default_categ_id': ref('bookstore_recommendation.product_category_books'), 'default_type': 'consu'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('product_template_book_view_list')}),
        ]"/>
    </record>
</odoo>
