<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Atributos del libro en la ficha de producto.
        Se inyecta dentro del bloque de detalle del producto, tras el precio.
    -->
    <template
        id="product_book_attributes"
        name="Product Page - Book Attributes"
        inherit_id="website_sale.product"
    >
        <xpath
            expr="//div[hasclass('o_wsale_product_details_content_section_cta')]"
            position="after"
        >
            <t t-if="product.book_author or product.book_publisher or product.book_pages or product.book_genre_id or product.book_isbn">
                <div class="mt-3 mb-3">
                    <table class="table table-sm table-borderless book-attributes-table"
                        style="max-width: 480px;">
                        <tbody>
                            <t t-if="product.book_author">
                                <tr>
                                    <th class="text-muted fw-normal ps-0" style="width:40%;">Autor</th>
                                    <td class="fw-semibold">
                                        <t t-esc="product.book_author" />
                                    </td>
                                </tr>
                            </t>
                            <t t-if="product.book_publisher">
                                <tr>
                                    <th class="text-muted fw-normal ps-0">Editorial</th>
                                    <td class="fw-semibold">
                                        <t t-esc="product.book_publisher" />
                                    </td>
                                </tr>
                            </t>
                            <t t-if="product.book_year">
                                <tr>
                                    <th class="text-muted fw-normal ps-0">Año de publicación</th>
                                    <td class="fw-semibold">
                                        <t t-esc="product.book_year" />
                                    </td>
                                </tr>
                            </t>
                            <t t-if="product.book_pages">
                                <tr>
                                    <th class="text-muted fw-normal ps-0">Páginas</th>
                                    <td class="fw-semibold">
                                        <t t-esc="product.book_pages" />
                                    </td>
                                </tr>
                            </t>
                            <t t-if="product.book_genre_id">
                                <tr>
                                    <th class="text-muted fw-normal ps-0">Género</th>
                                    <td class="fw-semibold">
                                        <t t-esc="product.book_genre_id.name" />
                                    </td>
                                </tr>
                            </t>
                            <t t-if="product.book_sub_genre_id">
                                <tr>
                                    <th class="text-muted fw-normal ps-0">Subgénero</th>
                                    <td class="fw-semibold">
                                        <t t-esc="product.book_sub_genre_id.name" />
                                    </td>
                                </tr>
                            </t>
                            <t t-if="product.book_isbn">
                                <tr>
                                    <th class="text-muted fw-normal ps-0">ISBN</th>
                                    <td class="fw-semibold">
                                        <t t-esc="product.book_isbn" />
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </xpath>
    </template>

    <!--
        Sección "Quizás también te interese" en la ficha de producto.
        Se inyecta después del bloque oe_structure_website_sale_product_2.
        El JS en recommendations.js hace el fetch y rellena el grid.
    -->
    <template
        id="product_similar_section"
        name="Product Page - Similar Books"
        inherit_id="website_sale.product"
    >
        <xpath
            expr="//div[@id='oe_structure_website_sale_product_2']"
            position="after"
        >
            <section
                id="bookstore_similar_products"
                class="container mt-5 mb-4"
                t-att-data-product-id="product.id"
            >
                <h3 class="mb-4 fw-bold">Quizás también te interese</h3>
                <div
                    id="bookstore_similar_products_grid"
                    class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3"
                >
                    <div class="col text-center text-muted py-4">
                        <small>Cargando recomendaciones...</small>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

    <!--
        Sección "Otros usuarios también compraron" en el carrito.
        Se inyecta después de la lista de productos del carrito.
    -->
    <template
        id="cart_user_recs"
        name="Cart - User Recommendations"
        inherit_id="website_sale.cart"
    >
        <xpath
            expr="//div[@id='oe_structure_website_sale_cart_1']"
            position="after"
        >
            <t t-if="website_sale_order and website_sale_order.website_order_line">
                <section
                    id="bookstore_cart_user_recommendations"
                    class="mt-5 mb-4"
                    t-att-data-order-id="website_sale_order.id"
                >
                    <h3 class="mb-4 fw-bold">Otros usuarios también compraron</h3>
                    <div
                        id="bookstore_cart_user_recs_grid"
                        class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3"
                    >
                        <div class="col text-center text-muted py-4">
                            <small>Cargando recomendaciones...</small>
                        </div>
                    </div>
                </section>
            </t>
        </xpath>
    </template>

    <!--
        Sección "Otros usuarios también compraron" en la confirmación de pedido.
        Se inyecta después del bloque oe_structure_website_sale_confirmation_2.
        El contexto de la plantilla provee `order` (sale.order).
    -->
    <template
        id="order_confirmation_user_recs"
        name="Order Confirmation - User Recommendations"
        inherit_id="website_sale.confirmation"
    >
        <xpath
            expr="//div[@id='oe_structure_website_sale_confirmation_2']"
            position="after"
        >
            <section
                id="bookstore_user_recommendations"
                class="mt-5 mb-4"
                t-att-data-order-id="order.id"
            >
                <div class="container">
                    <h3 class="mb-4 fw-bold">Otros usuarios también compraron</h3>
                    <div
                        id="bookstore_user_recs_grid"
                        class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3"
                    >
                        <div class="col text-center text-muted py-4">
                            <small>Cargando recomendaciones...</small>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>