<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="bookstore_home" name="Bookstore Homepage">
    <t t-call="website.layout">
        <t t-set="pageName" t-value="'bookstore_home'"/>

        <!-- Hero: search bar, light/white — estilo Casa del Libro -->
        <section class="bookstore-hero py-3">
            <div class="container">
                <div class="d-flex align-items-center justify-content-center">
                    <form action="/shop" method="get"
                          class="d-flex w-100" style="max-width:660px;">
                        <input
                            type="text"
                            name="search"
                            class="form-control border-end-0"
                            style="border-radius:4px 0 0 4px;"
                            placeholder="Busca por autor, título, género, ISBN..."
                            t-att-value="search_value"
                            autocomplete="off"
                        />
                        <button type="submit" class="bookstore-btn-search"
                                style="background:#fff;border:1px solid #e0e0e0;
                                       border-left:none;border-radius:0 4px 4px 0;
                                       padding:0 1rem;color:#757575;cursor:pointer;">
                            <i class="fa fa-search"/>
                        </button>
                    </form>
                </div>
            </div>
        </section>

        <!-- Barra de géneros — fondo blanco, texto oscuro, estilo Casa del Libro -->
        <nav class="bookstore-genre-nav sticky-top" style="z-index:100;">
            <div class="container">
                <ul class="nav py-1 flex-nowrap overflow-auto" style="gap:0;">
                    <li class="nav-item">
                        <a class="nav-link" href="/shop">
                            Ver todo
                        </a>
                    </li>
                    <t t-foreach="top_genres" t-as="genre">
                        <li class="nav-item">
                            <a class="nav-link"
                               t-attf-href="#genre-#{genre.id}">
                                <t t-out="genre.name"/>
                            </a>
                        </li>
                    </t>
                    <li class="nav-item ms-auto">
                        <a class="nav-link ofertas" href="/shop?tag=ofertas">
                            Ofertas
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Secciones de géneros -->
        <div class="bookstore-sections">
            <t t-foreach="genre_sections" t-as="section">
                <t t-set="genre" t-value="section['genre']"/>
                <t t-set="books" t-value="section['books']"/>

                <section t-attf-id="genre-#{genre.id}" class="py-4 border-bottom">
                    <div class="container">

                        <!-- Cabecera de sección -->
                        <div class="d-flex align-items-baseline
                                    justify-content-between mb-3">
                            <h2 class="bookstore-section-title mb-0 border-0 pb-0">
                                <t t-out="genre.name"/>
                            </h2>
                            <t t-if="genre.public_categ_id">
                                <a t-attf-href="/shop?category=#{genre.public_categ_id.id}"
                                   class="bookstore-section-link">
                                    Ver todos →
                                </a>
                            </t>
                            <t t-else="">
                                <a t-attf-href="/shop?search=#{genre.name}"
                                   class="bookstore-section-link">
                                    Ver todos →
                                </a>
                            </t>
                        </div>

                        <!-- Subgéneros como pills -->
                        <t t-if="genre.child_ids">
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <t t-foreach="genre.child_ids" t-as="child">
                                    <t t-if="child.public_categ_id">
                                        <a t-attf-href="/shop?category=#{child.public_categ_id.id}"
                                           class="bookstore-subgenre-pill">
                                            <t t-out="child.name"/>
                                            <span class="badge rounded-pill ms-1"
                                                  style="background:#f0f0f0;
                                                         color:#757575;
                                                         font-size:0.65rem;">
                                                <t t-out="child.product_count"/>
                                            </span>
                                        </a>
                                    </t>
                                    <t t-else="">
                                        <a t-attf-href="/shop?search=#{child.name}"
                                           class="bookstore-subgenre-pill">
                                            <t t-out="child.name"/>
                                            <span class="badge rounded-pill ms-1"
                                                  style="background:#f0f0f0;
                                                         color:#757575;
                                                         font-size:0.65rem;">
                                                <t t-out="child.product_count"/>
                                            </span>
                                        </a>
                                    </t>
                                </t>
                            </div>
                        </t>

                        <!-- Grid de libros -->
                        <t t-if="books">
                            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3">
                                <t t-foreach="books" t-as="book">
                                    <div class="col">
                                        <div class="card bookstore-book-card h-100 border-0">

                                            <!-- Portada -->
                                            <a t-att-href="book.website_url"
                                               class="text-decoration-none">
                                                <div class="bookstore-book-cover">
                                                    <img
                                                        t-attf-src="/web/image/product.template/#{book.id}/image_256"
                                                        t-att-alt="book.name"
                                                        loading="lazy"
                                                    />
                                                </div>
                                            </a>

                                            <!-- Datos del libro -->
                                            <div class="bookstore-book-body d-flex
                                                        flex-column flex-grow-1">
                                                <div class="bookstore-book-binding">
                                                    Tapa blanda
                                                </div>
                                                <a t-att-href="book.website_url"
                                                   class="text-decoration-none flex-grow-1">
                                                    <div class="bookstore-book-title">
                                                        <t t-out="book.name"/>
                                                    </div>
                                                    <div class="bookstore-book-author">
                                                        <t t-out="book.book_author or ''"/>
                                                    </div>
                                                </a>

                                                <!-- Precio: original tachado + descuento + final -->
                                                <div>
                                                    <div class="bookstore-price-row">
                                                        <span class="bookstore-price-original">
                                                            <t t-esc="'%.2f' % book.list_price"/> €
                                                        </span>
                                                        <span class="bookstore-discount-badge">
                                                            -5%
                                                        </span>
                                                    </div>
                                                    <div class="bookstore-price-final">
                                                        <t t-esc="'%.2f' % (book.list_price * 0.95)"/> €
                                                    </div>
                                                </div>

                                                <!-- Botones -->
                                                <a t-att-href="book.website_url"
                                                   class="bookstore-btn-view mt-2
                                                          text-center text-decoration-none">
                                                    VER FICHA
                                                </a>
                                                <a t-attf-href="/shop/cart/update?product_id=#{book.id}&amp;add_qty=1"
                                                   class="bookstore-btn-add
                                                          text-center text-decoration-none">
                                                    AÑADIR
                                                </a>
                                            </div>

                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                        <t t-else="">
                            <p class="text-muted small">
                                No hay libros disponibles en esta categoría.
                            </p>
                        </t>

                    </div>
                </section>
            </t>
        </div>

    </t>
</template>
</odoo>
